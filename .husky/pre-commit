#!/usr/bin/env bash
set -e

# Allow skipping hooks with environment variable
if [ "$SKIP_HOOKS" = "1" ]; then
  echo "Skipping git hooks (SKIP_HOOKS=1)"
  exit 0
fi

# Detect WSL (Linux kernel + Windows paths)
if grep -qi "microsoft" /proc/version 2>/dev/null; then
  IS_WSL=1
else
  IS_WSL=0
fi

# Ensure PATH includes common bun install locations
# Don't source .bashrc as it may contain bash-specific commands that fail in /bin/sh
export PATH="$PATH:$HOME/.bun/bin:/usr/local/bin:/opt/homebrew/bin:$HOME/.local/bin"

# If bun is still not found, try the Windows install path under WSL
if ! command -v bun >/dev/null 2>&1; then
  if [ "$IS_WSL" -eq 1 ]; then
    WIN_BUN_DIR="/mnt/c/Users/$USER/.bun/bin"
    if [ -x "$WIN_BUN_DIR/bun.exe" ]; then
      export PATH="$PATH:$WIN_BUN_DIR"
    fi
  fi
fi

# Final check: if no bun, skip hook instead of failing commit
if ! command -v bun >/dev/null 2>&1; then
  echo "husky pre-commit: 'bun' not found in PATH, skipping checks."
  exit 0
fi

# Get staged files (Added, Copied, Modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

# Exit early if no files are staged
if [ -z "$STAGED_FILES" ]; then
  echo "No files staged, skipping checks"
  exit 0
fi

# Check if package files are staged
PACKAGE_FILES_STAGED=false
if echo "$STAGED_FILES" | grep -qE "^(package\.json|bun\.lock)$"; then
  PACKAGE_FILES_STAGED=true
fi

# Run check:sync only if package files are staged
if [ "$PACKAGE_FILES_STAGED" = true ]; then
  bun run check:sync
fi

# Partially staged files are only checked: fixing and re-adding them would stage their unstaged hunks too.
FULLY_STAGED=""
PARTIAL=""
for file in $STAGED_FILES; do
  if git diff --quiet -- "$file" 2>/dev/null; then
    FULLY_STAGED="$FULLY_STAGED $file"
  else
    PARTIAL="$PARTIAL $file"
  fi
done
pick() { echo "$1" | tr ' ' '\n' | grep -E "$2" | tr '\n' ' ' || true; }
JS_RE='\.(js|jsx|ts|tsx|cjs|mjs)$'
PRETTIER_RE='\.(js|jsx|ts|tsx|cjs|mjs|json|css|scss|html|md|yml|yaml|svelte)$'
JS_FIX=$(pick "$FULLY_STAGED" "$JS_RE")
JS_CHECK=$(pick "$PARTIAL" "$JS_RE")
PRETTIER_FIX=$(pick "$FULLY_STAGED" "$PRETTIER_RE")
PRETTIER_CHECK=$(pick "$PARTIAL" "$PRETTIER_RE")

ESLINT=./node_modules/.bin/eslint
[ -x "$ESLINT" ] || ESLINT="bunx eslint"
PRETTIER=./node_modules/.bin/prettier
[ -x "$PRETTIER" ] || PRETTIER="bunx prettier"

if [ -n "$(echo $JS_FIX)" ]; then
  echo "Running ESLint with auto-fix on staged files..."
  $ESLINT --fix $JS_FIX || true
  $ESLINT --max-warnings=0 $JS_FIX
fi
if [ -n "$(echo $JS_CHECK)" ]; then
  echo "Running ESLint (check only) on partially staged files..."
  $ESLINT --max-warnings=0 $JS_CHECK
fi
if [ -n "$(echo $PRETTIER_FIX)" ]; then
  echo "Running Prettier to auto-format staged files..."
  $PRETTIER --write $PRETTIER_FIX
fi
if [ -n "$(echo $PRETTIER_CHECK)" ]; then
  echo "Running Prettier (check only) on partially staged files..."
  $PRETTIER --check $PRETTIER_CHECK
fi
for file in $JS_FIX $PRETTIER_FIX; do
  git add "$file" 2>/dev/null || true
done
