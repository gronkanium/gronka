{
  "name": "gronka",
  "version": "0.28.0",
  "description": "discord bot that downloads, optimizes, and converts media from social media",
  "main": "src/bot.js",
  "type": "module",
  "scripts": {
    "start": "bun src/bot.js",
    "webui": "bun src/webui-server.js",
    "webui:dev": "concurrently \"WEBUI_PORT=3002 bun src/webui-server.js\" \"vite\"",
    "webui:dev:server": "WEBUI_PORT=3002 bun src/webui-server.js",
    "build:webui": "bun scripts/build-webui.js",
    "register-commands": "bun src/register-commands.js",
    "dev": "bun --watch src/bot.js",
    "local": "bun run start",
    "local:stop": "echo \"Press Ctrl+C to stop, or manually kill bun processes\"",
    "local:up": "bun scripts/local-up.js",
    "local:down": "bun scripts/local-down.js",
    "local:logs": "bun scripts/local-logs.js",
    "local:restart": "bun scripts/local-restart.js",
    "local:verify": "bun scripts/local-verify.js",
    "local:register": "bun src/register-commands.js",
    "bot:test": "bun scripts/bot-start.js TEST",
    "bot:prod": "bun scripts/bot-start.js PROD",
    "bot:test:webui": "bun scripts/bot-start.js TEST --with-webui",
    "bot:prod:webui": "bun scripts/bot-start.js PROD --with-webui",
    "bot:test:dev": "bun --watch scripts/bot-start.js TEST",
    "bot:prod:dev": "bun --watch scripts/bot-start.js PROD",
    "bot:register:test": "bun src/register-commands.js TEST",
    "bot:register:prod": "bun src/register-commands.js PROD",
    "bot:status": "bun scripts/update-bot-status.js",
    "bot:status:docker": "bun scripts/update-bot-status.js --docker",
    "docker:up": "bun scripts/docker-up.js",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reload": "bun scripts/docker-reload.js",
    "docker:reload:fast": "bun scripts/docker-reload-fast.js",
    "docker:restart": "bun scripts/docker-restart.js",
    "docker:copy-webui": "bun scripts/docker-copy-webui.js",
    "docker:rebuild-webui": "bun scripts/docker-rebuild-webui.js",
    "docker:verify": "bun scripts/docker-verify.js",
    "docker:register": "docker compose exec app bun run register-commands",
    "check:sync": "bun scripts/check-lock-sync.js",
    "migrate:storage": "bun scripts/migrate-storage.js",
    "upload:404": "bun scripts/upload-404-to-r2.js",
    "user:stats": "bun scripts/user-stats.js",
    "delete:user-data": "bun scripts/delete-user-data.js",
    "fix:stuck-ops": "bun scripts/fix-stuck-operations.js",
    "fetch:security": "bun scripts/fetch-code-scanning-issues.js",
    "fetch:commands": "bun scripts/fetch-registered-commands.js",
    "reset:clean-slate": "bun scripts/reset-clean-slate.js",
    "fix:deps": "bun install",
    "validate": "bun run check:sync && bun run lint && bun run format:check",
    "pretest": "bun scripts/test-db-reset.js",
    "test": "NODE_ENV=test GIF_STORAGE_PATH=./data-test/gifs DISCORD_TOKEN=test-token CLIENT_ID=test-client-id R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET_NAME= COBALT_ENABLED=false WEBUI_PORT=3101 TEST_POSTGRES_DB=gronka_test bun test test/ --timeout 30000",
    "test:safe": "bun run test",
    "test:e2e": "NODE_ENV=test GRONKA_E2E=true DISCORD_TOKEN=test-token CLIENT_ID=test-client-id R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET_NAME= COBALT_ENABLED=true WEBUI_PORT=3101 TEST_POSTGRES_DB=gronka_test bun scripts/run-e2e-tests.js",
    "test:clean": "bun scripts/test-clean.js",
    "test:reset-db": "bun scripts/test-db-reset.js",
    "test:watch": "NODE_ENV=test GIF_STORAGE_PATH=./data-test/gifs DISCORD_TOKEN=test-token CLIENT_ID=test-client-id R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET_NAME= COBALT_ENABLED=false WEBUI_PORT=3101 TEST_POSTGRES_DB=gronka_test bun test test/ --timeout 30000 --watch",
    "test:safe:watch": "bun run test:watch",
    "lint": "eslint . --max-warnings=0",
    "lint:warn": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "wiki:sync": "bun scripts/sync-wiki-to-github.js",
    "prepare": "husky"
  },
  "keywords": [
    "discord",
    "bot",
    "gif",
    "video",
    "converter"
  ],
  "author": "gronkanium",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@noble/hashes": "^2.3.0",
    "axios": "^1.19.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-svelte": "^1.0.1",
    "postgres": "^3.4.9",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "vite": "^8.2.1"
  },
  "overrides": {
    "undici": "^6.27.0",
    "shell-quote": "^1.10.0",
    "brace-expansion": "^5.0.9"
  }
}
