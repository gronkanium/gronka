{
  "name": "gronka",
  "version": "3.1.0",
  "description": "discord bot that downloads, optimizes, and converts media from social media",
  "main": "src/bot.js",
  "type": "module",
  "scripts": {
    "start": "bun src/bot.js",
    "setup": "bun scripts/setup.js",
    "setup:check": "bun scripts/setup.js --check",
    "setup:repair": "bun scripts/setup.js --repair",
    "webui": "bun src/webui-server.js",
    "webui:dev": "concurrently \"WEBUI_PORT=3002 bun src/webui-server.js\" \"vite --config src/webui/vite.config.js\"",
    "webui:dev:server": "WEBUI_PORT=3002 bun src/webui-server.js",
    "build:webui": "bun scripts/build-webui.js",
    "register-commands": "bun src/register-commands.js",
    "dev": "bun --watch src/bot.js",
    "bot:test": "bun scripts/bot-start.js TEST",
    "bot:prod": "bun scripts/bot-start.js PROD",
    "bot:test:webui": "bun scripts/bot-start.js TEST --with-webui",
    "bot:prod:webui": "bun scripts/bot-start.js PROD --with-webui",
    "bot:test:dev": "bun --watch scripts/bot-start.js TEST",
    "bot:prod:dev": "bun --watch scripts/bot-start.js PROD",
    "bot:register:test": "bun src/register-commands.js TEST",
    "bot:register:prod": "bun src/register-commands.js PROD",
    "bot:status": "bun scripts/update-bot-status.js",
    "bot:status:docker": "bun scripts/update-bot-status.js --docker",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:register": "docker compose exec app bun run register-commands",
    "check:sync": "bun scripts/check-lock-sync.js",
    "check:public": "bun scripts/check-public.js",
    "fetch:security": "bun scripts/fetch-code-scanning-issues.js",
    "fetch:commands": "bun scripts/fetch-registered-commands.js",
    "validate": "bun run check:sync && bun run check:public && bun run lint && bun run format:check",
    "test": "NODE_ENV=test MEDIA_TEMP_DIR=./temp/test-jobs DISCORD_TOKEN=test-token CLIENT_ID=test-client-id R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET_NAME= COBALT_ENABLED=false WEBUI_PORT=3101 bun scripts/with-test-db.js bun test test/ web/worker/ --timeout 30000",
    "test:safe": "bun run test",
    "test:e2e": "NODE_ENV=test GRONKA_E2E=true MEDIA_TEMP_DIR=./temp/test-jobs DISCORD_TOKEN=test-token CLIENT_ID=test-client-id R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET_NAME= COBALT_ENABLED=true WEBUI_PORT=3101 bun scripts/with-test-db.js bun scripts/run-e2e-tests.js",
    "test:watch": "NODE_ENV=test MEDIA_TEMP_DIR=./temp/test-jobs DISCORD_TOKEN=test-token CLIENT_ID=test-client-id R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET_NAME= COBALT_ENABLED=false WEBUI_PORT=3101 bun scripts/with-test-db.js bun test test/ --timeout 30000 --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:warn": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path web/.gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path web/.gitignore",
    "wiki:sync": "bun scripts/sync-wiki-to-github.js",
    "prepare": "husky"
  },
  "keywords": [
    "discord",
    "bot",
    "gif",
    "video",
    "converter"
  ],
  "author": "gronkanium",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "concurrently": "^10.0.5",
    "escape-html": "^1.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lucide-svelte": "^1.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "tmp": "^0.2.7",
    "vite": "^8.3.1"
  },
  "overrides": {
    "undici": "^6.28.1",
    "ip-address": "^10.7.2",
    "shell-quote": "^1.10.0",
    "brace-expansion": "^5.0.11",
    "qs": "^6.16.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  }
}
