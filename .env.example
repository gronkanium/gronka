# gronka configuration
#
# How env vars work in this project:
#   - The app code (src/utils/config.js) reads PLAIN names: DISCORD_TOKEN, CLIENT_ID, SERVER_PORT, ...
#   - This .env uses PROD_* / TEST_* prefixes so one file can hold both bot instances.
#   - `npm run bot:prod` / `npm run bot:test` (scripts/bot-start.js) copies the chosen
#     prefix onto the plain names before starting the bot.
#   - docker-compose.yml does the same mapping for the production container.

# Suppress dotenv's random promotional "tip" banner + "injected env" log line
DOTENV_CONFIG_QUIET=true

# Discord, from https://discord.com/developers/applications
PROD_DISCORD_TOKEN=your_prod_bot_token
PROD_CLIENT_ID=your_prod_application_id
TEST_DISCORD_TOKEN=your_test_bot_token
TEST_CLIENT_ID=your_test_application_id

# Ports (stats server + webui, per instance)
PROD_SERVER_PORT=3000
PROD_WEBUI_PORT=3001
TEST_SERVER_PORT=3100
TEST_WEBUI_PORT=3101
TEST_WEBUI_HOST=0.0.0.0
SERVER_PORT=3000

# Media processing
# yt-dlp handles YouTube (and is the fallback for X/Twitter and TikTok); Cobalt handles everything else
YTDLP_ENABLED=true
# Optional Netscape-format cookies.txt for yt-dlp (needed for age-restricted TikTok).
# Export it with a cookies.txt browser extension and use it as-is; see wiki/Cookies.md.
# In Docker this defaults to /app/ytdlp-cookies.txt, mounted from ./ytdlp-cookies.txt.
#YTDLP_COOKIES_PATH=
# Optional cookies.json, service logins for gated content; see wiki/Cookies.md for the format.
# Note cobalt now reads its OWN copy (cobalt-cookies.json) because it rewrites the file it is
# given and drops services it does not recognise. With an `instagram` session in it, instagram
# posts download through instagram's own media-info api instead of cobalt, which is the only
# way photo and carousel posts work at all. In Docker this defaults to /app/cookies.json.
#INSTAGRAM_COOKIES_PATH=
COBALT_ENABLED=true
COBALT_API_URL=http://cobalt:9000

# Support/community server invite, shown in /info.
# Leave empty and neither surface mentions a server, do not point your users at someone
# else's Discord, they can't answer for your instance.
SUPPORT_INVITE_URL=

# Cloudflare R2 (optional): files too big for a Discord attachment go here as links.
# Without it, those files are refused.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# R2 cleanup: deletes each upload once it is older than its size tier allows (webui setting)
R2_CLEANUP_ENABLED=false
# How often it runs in milliseconds (default 1 hour)
R2_CLEANUP_INTERVAL_MS=3600000

# Retention: failure records (alerts) are deleted after RETENTION_DAYS. Nothing else is stored.
RETENTION_ENABLED=true
RETENTION_DAYS=7
# How often the job runs (default 6 hours)
RETENTION_INTERVAL_MS=21600000

# Logging goes to the console only. INFO is startup and job lifecycle, never a request.
#LOG_LEVEL=INFO

# PostgreSQL, test bot (local) and prod bot (Docker)
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_USER=gronka
TEST_POSTGRES_PASSWORD=change_me
TEST_POSTGRES_DB=gronka_test
PROD_POSTGRES_HOST=postgres
PROD_POSTGRES_PORT=5432
PROD_POSTGRES_USER=gronka
PROD_POSTGRES_PASSWORD=change_me
PROD_POSTGRES_DB=gronka
POSTGRES_HOST=localhost
